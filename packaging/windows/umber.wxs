<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Windows installer, built with WiX 5, installed as a global dotnet tool.

  Note for anyone editing this header: an XML comment may not contain two
  hyphens in a row, so a command line with a long option cannot be written
  here. That is what broke the first build of this file.

  Deliberately small. Umber is one executable with everything — brushes, fonts,
  papers, icons — compiled into it, so there is nothing to lay out beside it and
  no runtime to chain in. An installer that only has to place one file should
  look like one, which is why the dialog set is WixUI_Minimal: the licence, one
  Install button, one Cancel, and a page at the end.

  Two values come from the command line so nothing here has to be edited to cut
  a release: `Version` and `BinDir`. See `.github/workflows/release.yml`.

  The UpgradeCode must never change: it is what tells Windows that 0.0.2 is the
  same product as 0.0.1 and should replace it rather than install alongside it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Umber"
           Manufacturer="Umber contributors"
           Version="$(var.Version)"
           UpgradeCode="f3fbcac2-a3ac-4cf2-99fc-1dfa05429952"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Umber — GPU-accelerated painting application" />

    <!-- Refuse to install over a newer build rather than quietly downgrading. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Umber is already installed. Uninstall it first if you meant to go back." />

    <MediaTemplate EmbedCab="yes" />

    <!--
      The Id is a file name, not a label, and the extension is load-bearing.

      Windows Installer streams every Icon row out to a real file inside its own
      cache and names it with this Id; the shell then has to identify that file
      from its name alone, and `UmberIcon` gave it one with no extension. WiX's
      own `Shortcut.xsd` says the identifier "should have the same extension as
      the file that it points at". Whether that is what drew the generic page in
      Add/Remove Programs is inference — the documentation covers shortcuts
      rather than `ARPPRODUCTICON` — but an Id that is a valid file name costs
      nothing and is what every other package does.

      For the *shortcut* the rule is documented and is stronger than a naming
      convention: the Icon table requires an icon associated with a shortcut to
      be "in the EXE binary format" and "named such that their extension matches
      the extension of the target", and says the shortcut will not work
      otherwise. So no `.ico` row could ever have served it, whatever it was
      called, and satisfying the rule literally would mean an Icon row named
      `umber.exe` holding a PE copy of the executable — thirty megabytes of
      duplicate inside the package. Hence the Start Menu shortcut below names no
      icon at all and is not advertised: a real `.lnk` takes the icon out of the
      executable it points at, which is the `RT_GROUP_ICON` that
      `crates/umber-desktop/build.rs` compiles in and the same picture Explorer
      already draws on the file.
    -->
    <Icon Id="umber.ico" SourceFile="$(var.AssetDir)\umber.ico" />
    <Property Id="ARPPRODUCTICON" Value="umber.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Spillebulle/umber" />

    <!--
      One page with Install and Cancel on it, rather than the InstallDir set
      this used to use. Umber is one feature, one executable and three text
      files that go where it goes; the directory page offered a choice with one
      sensible answer, and a wizard whose middle pages only have Next on them is
      furniture.

      Two consequences worth knowing rather than discovering. `INSTALLFOLDER` is
      no longer choosable in the interface, though it can still be set from the
      command line:

        msiexec /i umber.msi INSTALLFOLDER="D:\Umber"

      And `WixUI_Minimal` sets `ARPNOMODIFY`, so the Add/Remove Programs entry
      loses its "Change" button. Repair and Remove keep their wizard — the
      maintenance dialogs are still in the set — and Change would only have led
      to the directory page that is the point of not using InstallDir.
    -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.AssetDir)\licence.rtf" />

    <!--
      The two pictures WixUI takes, drawn from `theme::Palette` by
      `umber-app`'s `installart` module and committed beside this file.
      Regenerating them is one ignored test; see that module for why they are
      light on the side MSI writes its headings over, which is the whole of what
      decides their layout.
    -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetDir)\dialog.bmp" />

    <!--
      "Start Umber" on the last page, ticked.

      `ExitDialog` has a spare checkbox built into it: give it text and it
      appears, and setting the property to 1 is what makes it start ticked.
      Ticked because somebody who has just chosen to install a painting
      application almost certainly wants to paint, and it is one click to say
      otherwise.

      `Impersonate="yes"` is the part that matters. Umber installs per-machine,
      so the installer is elevated; a launch without this would run Umber as the
      elevated account, and every preference, brush and autosave it wrote would
      land in that account's profile rather than the user's — invisible, and
      undone by the next login. With it, the action runs as whoever is sitting
      at the machine.

      Deferred to the Finish button rather than run at the end of the install,
      and conditioned on `NOT Installed`, so a repair or a change does not
      launch the application behind the user's back.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start Umber" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#UmberExe]" />
    <CustomAction Id="StartUmber"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="StartUmber"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Umber" />
    </StandardDirectory>

    <!--
      The Start Menu shortcut, and it is deliberately **not** advertised.

      Two things need it to be a plain `.lnk`. Its icon, for the reason the Icon
      element above gives. And `System.AppUserModel.ID`, which is the fifth
      mechanism the taskbar icon needed and the one that was missing:
      `taskbar::claim_identity` gives the process an explicit AppUserModelID,
      and Microsoft's rule for that is that the same id "must also be assigned
      to all running windows or processes, shortcuts, and file associations" —
      setting it on the shortcut is what "allows the taskbar to identify the
      proper shortcut to pin and ensures that windows belonging to the process
      are appropriately associated with that taskbar button". Without it the
      running window claims an identity nothing installed on the machine owns,
      so the button has no shortcut to take its icon, its name or its pinning
      from. `MsiShortcutProperty` is the table Microsoft names for doing this
      from an installer, and it is what this element compiles to.
      `umber-app`'s `taskbar` tests read the value back out of this file, so
      renaming the id in one place and not the other fails `cargo test` rather
      than shipping.

      The registry value is the price of a non-advertised shortcut: ICE43 is an
      *error* unless the component holding one has an HKCU key as its keypath,
      and validation runs as part of `wix build`. It is the arrangement
      Microsoft's own `DesktopToasts` sample uses for exactly this pair.

      **Do not "tidy" the root to HKMU.** It looks like the better answer — HKMU
      is root -1, which resolves per install context, so on a per-machine
      package like this one the marker would land in HKLM instead of in
      whichever hive the unimpersonated `WriteRegistryValues` sees. ICE43 even
      names root -1 in its own remedy. But ICE57 is the gate on the other side:
      it refuses per-user and per-machine data sharing a component, an HKLM
      keypath beside a non-advertised shortcut is that mix, and it reports it at
      *error* severity where the HKCU spelling is the one case its own examples
      print as a warning. WiX issue 2433 is that exact configuration, reported
      as LGHT0204. A stray marker in the wrong hive is a blemish; a release that
      will not build is not.
    -->
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="StartMenu" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="95c43486-778e-4975-9cb5-112e6ba93260">
        <Shortcut Id="UmberShortcut"
                  Name="Umber"
                  Description="Paint in Umber"
                  Target="[#UmberExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Advertise="no">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="io.github.spillebulle.umber" />
        </Shortcut>
        <RegistryValue Root="HKCU"
                       Key="Software\Umber contributors\Umber"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      File associations: Umber as an **option**, never as the default.

      This is deliberately not `<ProgId>` with `<Extension>` under the `File`
      element, which is WiX's obvious spelling and is the wrong one here. That
      writes the extension's *default* value, which is how an application makes
      itself the handler for a type — so installing Umber would take `.psd` away
      from Photoshop and `.clip` from Clip Studio, silently, on a machine where
      those are what the artist actually paints in. Umber reads those formats;
      it is not what somebody bought them to use.

      `OpenWithProgIds` is the registration that means "offer this too". The
      shell unions it with whatever else claims the type, so Umber appears in
      Open with and in "Choose another app" while the existing default is
      untouched. An empty REG_SZ is what the key wants — the value name is the
      ProgID and the data is deliberately nothing.

      Each ProgID carries its own `shell\open\command` with `"%1"` quoted,
      because a painter's file is called "Valorants magical bitches - Copy.clip"
      and an unquoted `%1` hands `crash::parse_args` six separate arguments, of
      which it would open the first. That parser takes the first bare argument
      as a document, which is the other half of this working at all: before it
      did, a double-click opened Umber on a blank canvas.

      `FriendlyAppName` on each ProgID is what the Open with list actually
      shows. Without it the entry reads "umber.exe".

      One component per ProgID, with the extension key as its keypath, so the
      whole set is installed, repaired and removed as a unit and an uninstall
      takes Umber back out of the menu rather than leaving a dead row that
      launches nothing.

      The five are `docimport::supported_extensions()`. `documents_umber_opens_
      are_registered_on_windows` reads that list against this file, so a format
      added to the importer fails `cargo test` until it is offered here too.
    -->
    <ComponentGroup Id="FileAssociations" Directory="INSTALLFOLDER">
      <Component Id="AssocOra" Guid="6f3a1c2e-9b47-4d18-8a52-1c0e77d4b301">
        <RegistryValue Root="HKCR" Key="Umber.ora" Type="string" Value="OpenRaster document" />
        <RegistryValue Root="HKCR" Key="Umber.ora" Name="FriendlyAppName" Type="string" Value="Umber" />
        <RegistryValue Root="HKCR" Key="Umber.ora\DefaultIcon" Type="string" Value="[#UmberExe],0" />
        <RegistryValue Root="HKCR" Key="Umber.ora\shell\open\command" Type="string" Value="&quot;[#UmberExe]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCR" Key=".ora\OpenWithProgIds" Name="Umber.ora" Type="string" Value="" KeyPath="yes" />
      </Component>
      <Component Id="AssocKra" Guid="2d84b60f-5e73-4a96-9f21-84b5c6e0a7d2">
        <RegistryValue Root="HKCR" Key="Umber.kra" Type="string" Value="Krita document" />
        <RegistryValue Root="HKCR" Key="Umber.kra" Name="FriendlyAppName" Type="string" Value="Umber" />
        <RegistryValue Root="HKCR" Key="Umber.kra\DefaultIcon" Type="string" Value="[#UmberExe],0" />
        <RegistryValue Root="HKCR" Key="Umber.kra\shell\open\command" Type="string" Value="&quot;[#UmberExe]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCR" Key=".kra\OpenWithProgIds" Name="Umber.kra" Type="string" Value="" KeyPath="yes" />
      </Component>
      <Component Id="AssocPsd" Guid="b1e7f394-0c62-4f85-9d47-3ea8250b16c9">
        <RegistryValue Root="HKCR" Key="Umber.psd" Type="string" Value="Photoshop document" />
        <RegistryValue Root="HKCR" Key="Umber.psd" Name="FriendlyAppName" Type="string" Value="Umber" />
        <RegistryValue Root="HKCR" Key="Umber.psd\DefaultIcon" Type="string" Value="[#UmberExe],0" />
        <RegistryValue Root="HKCR" Key="Umber.psd\shell\open\command" Type="string" Value="&quot;[#UmberExe]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCR" Key=".psd\OpenWithProgIds" Name="Umber.psd" Type="string" Value="" KeyPath="yes" />
      </Component>
      <Component Id="AssocClip" Guid="7c05d2a8-4318-49be-b6f0-9d21e83c5a4f">
        <RegistryValue Root="HKCR" Key="Umber.clip" Type="string" Value="Clip Studio Paint document" />
        <RegistryValue Root="HKCR" Key="Umber.clip" Name="FriendlyAppName" Type="string" Value="Umber" />
        <RegistryValue Root="HKCR" Key="Umber.clip\DefaultIcon" Type="string" Value="[#UmberExe],0" />
        <RegistryValue Root="HKCR" Key="Umber.clip\shell\open\command" Type="string" Value="&quot;[#UmberExe]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCR" Key=".clip\OpenWithProgIds" Name="Umber.clip" Type="string" Value="" KeyPath="yes" />
      </Component>
      <Component Id="AssocPng" Guid="e94a6b71-8d3f-4c02-a15e-62b7f0d4938a">
        <RegistryValue Root="HKCR" Key="Umber.png" Type="string" Value="PNG image" />
        <RegistryValue Root="HKCR" Key="Umber.png" Name="FriendlyAppName" Type="string" Value="Umber" />
        <RegistryValue Root="HKCR" Key="Umber.png\DefaultIcon" Type="string" Value="[#UmberExe],0" />
        <RegistryValue Root="HKCR" Key="Umber.png\shell\open\command" Type="string" Value="&quot;[#UmberExe]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCR" Key=".png\OpenWithProgIds" Name="Umber.png" Type="string" Value="" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Umber" Level="1">
      <ComponentGroupRef Id="Files" />
      <ComponentGroupRef Id="StartMenu" />
      <ComponentGroupRef Id="FileAssociations" />
    </Feature>

    <ComponentGroup Id="Files" Directory="INSTALLFOLDER">
      <Component Id="Executable" Guid="aaa698ce-4d5d-41c6-8f1e-5098c7fffb1b">
        <File Id="UmberExe" Source="$(var.BinDir)\umber.exe" KeyPath="yes" />
      </Component>
      <!--
        One component per file, rather than one holding all three.

        A component with no Guid gets one generated, and Windows Installer will
        only allow that when the component holds a single unversioned file that
        is its own keypath. Three files in one component is refused outright
        (WIX0367). Splitting them is also what the component rules ask for in
        any case: a component is the unit that gets installed, repaired and
        removed, and these three have no reason to share a fate.
      -->
      <Component Id="Readme">
        <File Source="$(var.DocDir)\README.md" />
      </Component>
      <Component Id="Changelog">
        <File Source="$(var.DocDir)\CHANGELOG.md" />
      </Component>
      <Component Id="Licence">
        <File Source="$(var.DocDir)\LICENSE" Name="LICENSE.txt" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
