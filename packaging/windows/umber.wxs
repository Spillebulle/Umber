<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Windows installer, built with WiX 5, installed as a global dotnet tool.

  Note for anyone editing this header: an XML comment may not contain two
  hyphens in a row, so a command line with a long option cannot be written
  here. That is what broke the first build of this file.

  Deliberately small. Umber is one executable with everything — brushes, fonts,
  papers, icons — compiled into it, so there is nothing to lay out beside it and
  no runtime to chain in. An installer that only has to place one file should
  look like one.

  Two values come from the command line so nothing here has to be edited to cut
  a release: `Version` and `BinDir`. See `.github/workflows/release.yml`.

  The UpgradeCode must never change: it is what tells Windows that 0.0.2 is the
  same product as 0.0.1 and should replace it rather than install alongside it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Umber"
           Manufacturer="Umber contributors"
           Version="$(var.Version)"
           UpgradeCode="f3fbcac2-a3ac-4cf2-99fc-1dfa05429952"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Umber — GPU-accelerated painting application" />

    <!-- Refuse to install over a newer build rather than quietly downgrading. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Umber is already installed. Uninstall it first if you meant to go back." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="UmberIcon" SourceFile="$(var.AssetDir)\umber.ico" />
    <Property Id="ARPPRODUCTICON" Value="UmberIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Spillebulle/umber" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.AssetDir)\licence.rtf" />

    <!--
      "Start Umber" on the last page, ticked.

      `WixUI_InstallDir`'s exit dialog has a spare checkbox built into it: give
      it text and it appears, and setting the property to 1 is what makes it
      start ticked. Ticked because somebody who has just chosen to install a
      painting application almost certainly wants to paint, and it is one click
      to say otherwise.

      `Impersonate="yes"` is the part that matters. Umber installs per-machine,
      so the installer is elevated; a launch without this would run Umber as the
      elevated account, and every preference, brush and autosave it wrote would
      land in that account's profile rather than the user's — invisible, and
      undone by the next login. With it, the action runs as whoever is sitting
      at the machine.

      Deferred to the Finish button rather than run at the end of the install,
      and conditioned on `NOT Installed`, so a repair or a change does not
      launch the application behind the user's back.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start Umber" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#UmberExe]" />
    <CustomAction Id="StartUmber"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="StartUmber"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Umber" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Umber" Level="1">
      <ComponentGroupRef Id="Files" />
    </Feature>

    <ComponentGroup Id="Files" Directory="INSTALLFOLDER">
      <Component Id="Executable" Guid="aaa698ce-4d5d-41c6-8f1e-5098c7fffb1b">
        <File Id="UmberExe" Source="$(var.BinDir)\umber.exe" KeyPath="yes">
          <!-- Under the executable, so the shortcut is removed with it. -->
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Umber"
                    Icon="UmberIcon"
                    Advertise="yes" />
        </File>
      </Component>
      <!--
        One component per file, rather than one holding all three.

        A component with no Guid gets one generated, and Windows Installer will
        only allow that when the component holds a single unversioned file that
        is its own keypath. Three files in one component is refused outright
        (WIX0367). Splitting them is also what the component rules ask for in
        any case: a component is the unit that gets installed, repaired and
        removed, and these three have no reason to share a fate.
      -->
      <Component Id="Readme">
        <File Source="$(var.DocDir)\README.md" />
      </Component>
      <Component Id="Changelog">
        <File Source="$(var.DocDir)\CHANGELOG.md" />
      </Component>
      <Component Id="Licence">
        <File Source="$(var.DocDir)\LICENSE" Name="LICENSE.txt" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
