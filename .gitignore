/target
**/*.rs.bk
*.pdb

# Downloaded brush packs. `tools/fetch-brushes.ps1` puts them here; they are
# other people's work, they are large, and git keeps everything forever — so
# only the licence record and the generated library are committed.
/assets/brushes/*
!/assets/brushes/LICENSES.md

# Android
/platform/android/.gradle
/platform/android/build
/platform/android/local.properties
/platform/android/app/build

# iOS / Xcode
/platform/ios/build
xcuserdata/
*.xcworkspace/xcuserdata/

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Agent worktrees. Git worktrees of this same repository; never content.
.claude/worktrees/

# Editor safe-backup copies. They are stale duplicates of a real source
# file and compile as one, which is a confusing way to find out.
*safeBackup*

# Release build products. `packaging/linux/build-packages.sh` and the Flatpak
# build stage things here; the packages themselves live on a GitHub release.
/dist
/out
/packaging/linux/umber-linux.tar.gz
/packaging/linux/build-dir
/packaging/linux/repo
/packaging/linux/.flatpak-builder
/wixassets
